# ===================================================================
# 회사(사내 배포) 프로필
#   cp config/profiles/company.env.example .env   후 값만 채우세요.
#
# 여기 있는 값은 전부 "환경변수"입니다. 코드는 한 줄도 고치지 않습니다.
# 이 파일과 config/apps.seed.json 은 회사 밖으로 나가지 않습니다.
# ===================================================================

POSTGRES_USER=workflow
POSTGRES_PASSWORD=사내에서_정한_비밀번호
POSTGRES_DB=workflow
DATABASE_URL=postgresql+psycopg://workflow:사내에서_정한_비밀번호@postgres:5432/workflow
REDIS_URL=redis://redis:6379/0

# --- 사내 Gauss ---
# Gauss 의 OpenAI 호환 주소를 적습니다. 보통 .../v1 로 끝납니다.
LLM_BASE_URL=https://사내-gauss-주소/v1
LLM_API_KEY=발급받은_키
LLM_MODEL=사내에서_알려준_모델명
# Gauss 가 tool calling 을 지원하면 native, 아니면 json
LLM_TOOL_MODE=native
LLM_TIMEOUT=180

MCP_TIMEOUT=120

# 관리자 사번(쉼표 구분). 이 사람만 앱을 '공식'으로 승인할 수 있습니다.
ADMIN_USER_IDS=관리자_사번

# 사내에서 접속할 백엔드 주소 (브라우저 기준)
NEXT_PUBLIC_API_BASE=http://사내서버주소:8000

# 사내 앱 목록. 이 파일은 회사 저장소에만 둡니다(집 저장소에는 올리지 않음).
SEED_FILE=config/apps.seed.json,config/apps.seed.official.json

# 사내 PyPI 미러(Nexus 등). docker compose build 시 사용.
# PIP_INDEX_URL=https://nexus.사내주소/repository/pypi/simple
# PIP_TRUSTED_HOST=nexus.사내주소

# --- 실행 환경 ---
# production 으로 두면, 위험한 설정(아래 SECRET_KEY / DEV_HEADER_AUTH / CORS_ORIGINS)이
# 하나라도 남아 있을 때 서버가 아예 뜨지 않고 이유를 찍습니다.
APP_ENV=production
# 브라우저에서 이 서버를 부를 수 있는 주소. 쉼표로 여러 개. * 는 운영에서 쓸 수 없습니다.
CORS_ORIGINS=http://사내서버주소:3000

# --- 로그인 ---
# 반드시 긴 임의 문자열로 바꾸세요. 예) python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=반드시_바꾸세요
# 앱 접속 정보(토큰·비번)를 DB 에 잠가 넣을 때 쓰는 열쇠. 비우면 SECRET_KEY 를 같이 씁니다.
# 따로 정해 두면, 나중에 SECRET_KEY 만 바꿔도 앱 접속 정보를 다시 넣지 않아도 됩니다.
# 이 값을 바꾸면 이미 저장된 접속 정보는 못 풉니다(앱 등록 화면에서 다시 입력해야 함).
ENCRYPTION_KEY=반드시_바꾸세요_다른값으로
# 관리자 계정. 서버가 처음 뜰 때 이 값으로 만들어집니다.
# 비밀번호는 이 파일(.env)에만 적습니다. 저장소에 올리지 마세요.
ADMIN_ID=admin
ADMIN_PASSWORD=여기에_비밀번호
ADMIN_NAME=관리자
# 비밀번호를 잊었을 때만 잠깐 true 로 두면 기동할 때 위 값으로 덮어씁니다.
ADMIN_RESET_PASSWORD=false
# 사내 SSO 로 들어왔을 때 관리자로 볼 아이디(쉼표 구분)
ADMIN_SSO_IDS=sk1980.kim
# 회사 배포에서는 반드시 false (헤더만으로 로그인되는 개발용 통로를 막습니다)
DEV_HEADER_AUTH=false
# 사내 SSO 연동이 끝나면 sso 로 바꾸세요 (app/auth/backend.py 의 SsoBackend)
AUTH_BACKEND=password

# --- 파일 보관 (앱 패키지, 양식) ---
DATA_DIR=/srv/data

# --- 앱 생존 확인 ---
HEALTHCHECK_INTERVAL_SECONDS=300
HEALTHCHECK_FAILURE_THRESHOLD=3

# --- 예약(스케줄러) ---
SCHEDULER_TZ_OFFSET_MINUTES=540
SCHEDULER_ENABLED=true
SCHEDULER_MIN_INTERVAL_MINUTES=5

# --- 개인 대시보드 ---
# 사내 앱의 기능 이름이 다르면 이 파일만 바꿔 끼우면 됩니다.
# (config/dashboard.widgets.example.json 를 복사해서 고치세요)
# DASHBOARD_WIDGETS_FILE=config/dashboard.widgets.json
DASHBOARD_TIMEOUT=10
# --- 공식 앱: 사내 메일 ---
# mock = 가짜 메일함(메일이 나가지 않음), smtp = 사내 메일로 실제 발송.
# 사내 메일 연결 방식이 확인되고 official_apps/mail/adapters/smtp_imap.py 를
# 채운 뒤에 smtp 로 바꾸세요. 그 전까지는 mock 으로 두면 안전합니다.
MAIL_ADAPTER=mock

# 아래 값은 회사 IT/메일 담당에게 확인한 뒤 채웁니다. 확인 전에는 비워 두세요.
# MAIL_FROM=보내는_주소
# MAIL_SMTP_HOST=사내_smtp_주소
# MAIL_SMTP_PORT=25
# MAIL_SMTP_USER=계정
# MAIL_SMTP_PASSWORD=비밀번호
# MAIL_SMTP_TLS=true
# 회신 여부 확인(받은 편지함 읽기)이 열려 있을 때만 채웁니다.
# MAIL_IMAP_HOST=사내_imap_주소
# MAIL_IMAP_PORT=993
# MAIL_IMAP_USER=계정
# MAIL_IMAP_PASSWORD=비밀번호
# MAIL_IMAP_FOLDER=INBOX

# 공식 앱 화면(메일함, 할 일)이 부를 주소. 브라우저 기준입니다.
NEXT_PUBLIC_MAIL_API=http://사내서버주소:9101
NEXT_PUBLIC_TASKS_API=http://사내서버주소:9103
NEXT_PUBLIC_APPLIANCE_API=http://사내서버주소:9119

# --- 공식 앱 (official_apps/) ---
# 채운 엑셀·워드 파일 내려받기 주소. 사내에서 접속하는 서버 주소로 바꾸세요.
OFFICIAL_APPS_HOST=http://워크플로우-서버-주소
# 산출물 앱이 플랫폼 양식 저장소를 읽을 때 쓰는 계정 토큰.
# 회사에서는 DEV_HEADER_AUTH=false 이므로 토큰이 필요합니다.
WORKFLOW_API_BASE=http://backend:8000
WORKFLOW_API_TOKEN=

# --- 공식 앱: 가전 신제품 조사 (9119) ---
# 제조사 홈페이지에 나가야 합니다. 회사 프록시를 거쳐야 하면 채우세요.
# HTTPS_PROXY=http://프록시주소:포트
# 제조사 홈페이지 주소를 모를 때 스스로 찾게 하는 검색 API (없어도 기본 주소로 돕니다)
#   searxng: 사내에 띄운 SearXNG 주소 / brave: https://api.search.brave.com/res/v1/web/search
# SEARCH_PROVIDER=searxng
# SEARCH_API_URL=http://searxng:8080
# SEARCH_API_KEY=
# 신제품으로 볼 기간(출시일 기준, 일)
# NEW_WITHIN_DAYS=180
# 가격대 비교용 환율(1달러에 얼마). 비우면 앱에 든 대략값을 씁니다.
# FX_RATES_JSON={"EUR":0.92,"KRW":1380}
# 일부 제조사 사이트(예: GE)가 일반 요청을 막으면 진짜 브라우저로 한 번 더 엽니다.
#   pip install -r requirements.txt 만으로는 부족하고 playwright install chromium 도 필요합니다.
# BROWSER_FETCH_FALLBACK=true
# CHROMIUM_EXECUTABLE_PATH=
# 최근 화제(뉴스·유튜브) — 아직 홈페이지에 안 올라온 발표 직후 신제품 포착용.
# 뉴스(Google News RSS)는 키 없이 기본으로 켜져 있습니다.
# TREND_NEWS_ENABLED=true
# 유튜브는 이 키가 있어야 됩니다(없으면 조용히 빈 목록). https://console.cloud.google.com 에서 발급.
# YOUTUBE_API_KEY=

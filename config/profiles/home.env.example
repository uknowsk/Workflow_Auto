# ===================================================================
# 집(개발용) 프로필
#   cp config/profiles/home.env.example .env
# 외부 인터넷을 쓰거나, LLM 없이 구조만 돌려볼 때 쓰는 값입니다.
# ===================================================================

POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_DB=workflow
DATABASE_URL=postgresql+psycopg://workflow:workflow@postgres:5432/workflow
REDIS_URL=redis://redis:6379/0

# 집에서는 아무 OpenAI 호환 엔드포인트나 꽂으면 됩니다.
# 예) Ollama:  http://host.docker.internal:11434/v1  / 모델명 qwen2.5
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5
LLM_TOOL_MODE=native
LLM_TIMEOUT=120

MCP_TIMEOUT=60

# 관리자 사번(쉼표 구분). 이 사람만 앱을 '공식'으로 승인할 수 있습니다.
# 화면 첫 줄의 '사용 중인 사번'을 여기 값과 똑같이 맞추면 관리자 화면이 열립니다.
ADMIN_USER_IDS=demo
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 집에서는 예시 앱과 공식 앱을 자동 등록해서 흐름을 확인합니다.
# 쉼표로 여러 목록 파일을 적을 수 있습니다.
SEED_FILE=config/apps.seed.example.json,config/apps.seed.official.json

# --- 로그인 ---
# 토큰 서명용 비밀값. 회사에서는 반드시 긴 임의 문자열로 바꾸세요.
SECRET_KEY=dev-secret-change-me
# 서버가 처음 뜰 때 만들 최초 관리자 계정
BOOTSTRAP_ADMIN_ID=demo
BOOTSTRAP_ADMIN_PASSWORD=demo1234
# 개발 편의: X-User-Id 헤더만으로 로그인한 척 허용. 회사에서는 false.
DEV_HEADER_AUTH=true
AUTH_BACKEND=password

# --- 파일 보관 (앱 패키지, 양식) ---
DATA_DIR=/srv/data

# --- 앱 생존 확인 ---
HEALTHCHECK_INTERVAL_SECONDS=300
HEALTHCHECK_FAILURE_THRESHOLD=3

# --- 예약(스케줄러) ---
# 사내 표준시. 한국은 540(UTC+9). "매일 09시"가 어느 나라 9시인지 정하는 값입니다.
SCHEDULER_TZ_OFFSET_MINUTES=540
SCHEDULER_ENABLED=true
# 예약이 이 간격보다 자주 돌지 못하게 막습니다.
SCHEDULER_MIN_INTERVAL_MINUTES=5

# --- 개인 대시보드 ---
# 첫 화면에 어떤 칸을 띄울지 적은 파일. 비우면 기본값을 씁니다.
# DASHBOARD_WIDGETS_FILE=config/dashboard.widgets.json
DASHBOARD_TIMEOUT=10
# --- 공식 앱: 사내 메일 ---
# mock = 가짜 메일함. 실제로 메일이 나가지 않고 앱 DB에 쌓여 /mail 화면에서 보입니다.
# 집에서 시나리오를 검증할 때는 이 값 그대로 두세요.
MAIL_ADAPTER=mock

# 공식 앱 화면(메일함, 할 일)이 부를 주소. 브라우저 기준입니다.
NEXT_PUBLIC_MAIL_API=http://localhost:9101
NEXT_PUBLIC_TASKS_API=http://localhost:9103

# --- 공식 앱 (official_apps/) ---
# 채운 엑셀·워드 파일 내려받기 주소에 쓰는 호스트. 다른 PC에서 접속하면 그 주소로 바꾸세요.
OFFICIAL_APPS_HOST=http://localhost
# 산출물 앱이 플랫폼 양식 저장소도 같이 쓰게 하려면 채우세요.
# 개발 중에는 DEV_HEADER_AUTH=true 라서 사번만 있으면 됩니다.
WORKFLOW_API_BASE=http://backend:8000
WORKFLOW_API_USER=demo
